        "type": "prometheus",
        "uid": "PROM"
      },
      "gridPos": {
        "x": 4,
        "y": 1,
        "w": 4,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum(rate(dims_responses_total{code=~\"5..\"}[1m])) / clamp_min(sum(rate(dims_responses_total[1m])), 0.001)",
