/*
 * The version and the build this module came from.
 *
 * CMake generates this from version.h.in. DIMS_VERSION is the project()
 * version and the pre-release suffix beside it, which is the one place the
 * version is written.
 * DIMS_COMMIT is the short git commit, or "unknown" when the tree is not a
 * git checkout. It is read when CMake configures, not on every build, so a
 * build without a reconfigure keeps the commit it was configured with.
 *
 * Copyright 2026 Jeremy Collins
 * SPDX-License-Identifier: Apache-2.0
 */

#ifndef _DIMS_VERSION_H
#define _DIMS_VERSION_H

#define DIMS_VERSION "@DIMS_VERSION@"
#define DIMS_COMMIT "@DIMS_COMMIT@"

#endif
